{
  "name": "mainstreet",
  "private": true,
  "description": "MAINSTREET, a kids' investing game. Dev dependencies only; nothing here ships.",
  "type": "module",
  "scripts": {
    "setup": "bash tools/setup.sh",
    "test": "node tools/test.mjs",
    "ui": "npx playwright test",
    "check": "node tools/test.mjs && node tools/join.mjs --check && npx playwright test",
    "split": "node tools/split.mjs",
    "join": "node tools/join.mjs",
    "harness": "node tools/harness.mjs --seeds 10000 --family all --heldout --report docs/calibration.md",
    "art": "node tools/art_manifest.mjs",
    "sprites": "node tools/gen_art.mjs",
    "music": "node tools/music_check.mjs",
    "shots": "node tools/shots.mjs",
    "calibrate-v1": "node tools/calibrate-v1.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0"
  }
}
