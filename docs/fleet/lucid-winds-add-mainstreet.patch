diff --git a/satellites/mainstreet/index.html b/satellites/mainstreet/index.html
new file mode 100644
index 0000000..3d01b21
--- /dev/null
+++ b/satellites/mainstreet/index.html
@@ -0,0 +1,1764 @@
+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
+<meta name="color-scheme" content="light">
+<title>MAINSTREET</title>
+<link rel="manifest" href="manifest.webmanifest">
+<meta name="theme-color" content="#F3EEE2">
+<meta name="description" content="A free, offline, kid-safe investing game. Own little pieces of a town. Make a plan. See what time changes.">
+<style>
+/* MAINSTREET styles (M2). Paper town tokens; 48 px controls; blue up, orange down; no filters or heavy shadows. */
+:root{--paper:#F3EEE2;--paper-2:#EAE3D3;--card:#FBF8F1;--ink:#2B2420;--ink-2:#5E554E;--ink-3:#8A817A;--rule:#D9D0BE;--up:#0072B2;--down:#E69F00;--up-soft:#DCEBF5;--down-soft:#FBEFD2;--soon:#0072B2;--buffer:#6A994E;--saved:#8E7CC3;--ts:1;}
+*{box-sizing:border-box}
+html,body{height:100%;margin:0;background:var(--paper);color:var(--ink)}
+body{font:calc(18px * var(--ts))/1.45 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;padding:0 0 env(safe-area-inset-bottom,0px)}
+#app{min-height:100%}
+.screen{max-width:720px;margin:0 auto;padding:12px 16px 32px;display:flex;flex-direction:column;gap:12px}
+h1,h2,h3{margin:0;line-height:1.15;text-wrap:balance}
+h1{font-size:2.2em;letter-spacing:.04em}h2{font-size:1.5em}h3{font-size:1.1em;color:var(--ink-2)}
+p{margin:0}
