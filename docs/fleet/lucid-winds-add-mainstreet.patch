+function chimeOnce(key) { if (S.ui.chimed === key) return; S.ui.chimed = key; chime(); }
+
+/* focus: a screen change lands on the screen's heading; an in-screen re-render keeps focus on the same control; a sheet that opens takes focus */
+const FOCUS = { view: '' };
