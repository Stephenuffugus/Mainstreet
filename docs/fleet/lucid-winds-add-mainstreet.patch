+/* one quiet two-note chime, about a second, for the Gazette and the chapter end. Nothing like a payout. */
+function chime() {
+  const c = audio(); if (!c) return;
+  try {
+    const t = c.currentTime;
+    [[523.25, 0.05, 0], [784, 0.03, 0.14]].forEach(([hz, vol, at]) => {
