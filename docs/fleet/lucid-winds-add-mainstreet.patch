+  if (track === MUSIC.cur) { if (MUSIC.el && MUSIC.el.paused) { const p = MUSIC.el.play(); if (p && p.catch) p.catch(() => {}); } return; }
+  playTrack(track);
+}
+function setMusic(on) { S.options.music = !!on; saveSettings(); if (on) { MUSIC.armed = true; musicTick(); } else stopMusic(); render(); }
+function setMusicVolume(v) { S.options.musicVolume = Math.max(0, Math.min(100, Math.round(v))); saveSettings(); if (MUSIC.el && !MUSIC.fade) MUSIC.el.volume = musicVolume(MUSIC.cur); }
+function musicState() { const f = musicFeel(); return { available: !!MUSIC.manifest, on: !!S.options.music, armed: MUSIC.armed, muted: MUSIC.muted, key: f.key, feel: f.feel, track: MUSIC.cur ? (MUSIC.cur.title || MUSIC.cur.file) : null, playing: !!(MUSIC.el && !MUSIC.el.paused) }; }
+function musicControl() {
+  if (!MUSIC.manifest) return null;
+  return el('button', { type: 'button', class: 'btn music', 'aria-pressed': S.options.music ? 'true' : 'false', onclick: () => setMusic(!S.options.music), text: S.options.music ? '♫ Music on' : '♫ Music off' });
+}
+function nowPlayingLine() { const st = musicState(); return st.track ? 'Now playing: ' + st.track + ' (' + st.feel + ', for ' + st.key + ')' : 'Nothing playing yet. Music starts after your first tap.'; }
+function startMusicSystem() {
+  const arm = () => { if (MUSIC.armed) return; MUSIC.armed = true; musicTick(); };
