+  const t = cands[Math.min(prev.idx, cands.length - 1)]; if (t) { try { t.focus({ preventScroll: true }); } catch (e) {} }
+}
+
+
+/* ---- M8: music. Stephen's songs, assigned by the feel of each moment (docs/MUSIC.md). Optional, off by default, starts after the first tap. ---- */
+const MUSIC = { manifest: null, cur: null, el: null, armed: false, muted: false, fade: null };
+function loadMusic() {
+  if (location.protocol === 'file:') { MUSIC.manifest = null; return Promise.resolve(); }
+  return fetch('music/manifest.json').then(r => r.ok ? r.json() : null).then(j => { MUSIC.manifest = j && Array.isArray(j.tracks) && j.tracks.length ? j : null; }).catch(() => { MUSIC.manifest = null; });
+}
+function musicFeelKey() {
+  const sc = S.screen;
+  if (sc === 'show' && S.ui.lastShow && S.ui.lastShow.length) { const f = S.ui.lastShow[0]; return f.mood === 'S' ? 'show-slump' : 'show-' + f.weather; }
+  if (sc === 'town' && S.run && S.ui.intro) return 'intro';
+  if (sc === 'town' && S.run && S.market && S.draft && S.market.moods[S.draft.t] === 'S') return 'town-slump';
+  return sc;
+}
+function musicFeel() { const map = (MUSIC.manifest && MUSIC.manifest.map) || {}; const key = musicFeelKey(); return { key, feel: map[key] || map[key.split('-')[0]] || map.default || 'calm' }; }
+function musicVolume(track) { const v = S.options.musicVolume == null ? 60 : S.options.musicVolume; return Math.max(0, Math.min(1, v / 100 * (track && track.gain != null ? track.gain : 1))); }
