+function restoreFocus(root, view, prev) {
+  const viewKey = S.screen + '|' + (S.run && S.screen === 'town' && S.ui.intro ? 'intro' : '') + '|' + (S.run ? S.run.runId : '');
+  const sheet = view.querySelector('[role="dialog"], [role="alertdialog"]');
