+}
+function makeAudio(track) { const a = new Audio('music/' + track.file); a.loop = track.loop !== false; a.preload = 'auto'; a.volume = 0; a.addEventListener('ended', () => { if (MUSIC.el === a) { MUSIC.cur = null; musicTick(); } }); return a; }
