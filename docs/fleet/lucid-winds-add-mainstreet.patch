+  document.addEventListener('visibilitychange', () => { if (!MUSIC.el) return; if (document.hidden) MUSIC.el.pause(); else if (S.options.music && !MUSIC.muted) { const p = MUSIC.el.play(); if (p && p.catch) p.catch(() => {}); } });
